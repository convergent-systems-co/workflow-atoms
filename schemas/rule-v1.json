{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-atoms.com/schemas/rule-v1.json",
  "title": "workflow-atoms v1 rule",
  "description": "A typed constraint that enforces a policy across atoms or compositions — ordering rules, mutual-exclusion rules, timeout ceilings, retry caps, or approval gates.",
  "type": "object",
  "required": ["schema", "id", "version", "name", "rule_type", "applies_to"],
  "properties": {
    "schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9/-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "rule_type": {
      "type": "string",
      "enum": [
        "ordering",
        "mutual-exclusion",
        "timeout-ceiling",
        "retry-cap",
        "approval-gate",
        "input-validation",
        "output-assertion"
      ]
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "description": "Atom IDs or type globs this rule constrains.",
      "items": {"type": "string"}
    },
    "constraint": {
      "type": "object",
      "description": "Rule-type-specific constraint payload."
    },
    "severity": {
      "type": "string",
      "enum": ["error", "warning"],
      "default": "error"
    },
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
