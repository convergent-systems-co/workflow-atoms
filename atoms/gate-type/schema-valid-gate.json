{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "gate-type",
  "id": "workflow-atoms/gate-type/schema-valid-gate",
  "version": "1.0.0",
  "name": "Schema Valid Gate",
  "description": "Block the pipeline if any atoms failed schema validation. Passes only when invalid_count is zero.",
  "inputs": [
    {"name": "invalid_count", "type": "integer", "required": true}
  ],
  "outputs": [
    {"name": "passed", "type": "boolean"}
  ],
  "retryable": false,
  "tags": ["gate", "schema", "atoms"]
}
