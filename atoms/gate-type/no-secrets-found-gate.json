{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "gate-type",
  "id": "workflow-atoms/gate-type/no-secrets-found-gate",
  "version": "1.0.0",
  "name": "No Secrets Found Gate",
  "description": "Block the pipeline if any secrets were detected in the secret scan. Passes only when findings_count is zero.",
  "inputs": [
    {"name": "findings_count", "type": "integer", "required": true}
  ],
  "outputs": [
    {"name": "passed", "type": "boolean"}
  ],
  "retryable": false,
  "tags": ["gate", "security", "secrets"]
}
