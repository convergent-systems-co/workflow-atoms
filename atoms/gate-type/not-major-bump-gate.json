{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "gate-type",
  "id": "workflow-atoms/gate-type/not-major-bump-gate",
  "version": "1.0.0",
  "name": "Not a Major Version Bump Gate",
  "description": "Pass only when the dependency update is NOT a major version bump. Major bumps are routed for manual review.",
  "inputs": [
    {"name": "is_major", "type": "boolean", "required": true}
  ],
  "outputs": [
    {"name": "passed", "type": "boolean"}
  ],
  "retryable": false,
  "tags": ["gate", "dependabot", "semver"]
}
