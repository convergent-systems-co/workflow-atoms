{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/sign-artifact",
  "version": "1.0.0",
  "name": "Sign Artifact",
  "description": "Cryptographically sign a build artifact or release archive using cosign, GPG, or sigstore.",
  "inputs": [
    {"name": "artifact_path", "type": "string", "required": true},
    {"name": "signing_key", "type": "string", "required": false},
    {"name": "signer", "type": "string", "required": false}
  ],
  "outputs": [
    {"name": "signature_path", "type": "string"},
    {"name": "verified", "type": "boolean"}
  ],
  "retryable": false,
  "tags": ["security", "signing", "release"]
}
