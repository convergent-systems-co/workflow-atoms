{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/setup-secrets",
  "version": "1.0.0",
  "name": "Setup Secrets",
  "description": "Provision developer secrets from a vault or template into the local environment (creates .env files from vault, keyring, or 1Password).",
  "inputs": [
    {"name": "secret_source", "type": "string", "required": true},
    {"name": "env_file_path", "type": "string", "required": false}
  ],
  "outputs": [
    {"name": "secrets_written", "type": "integer"},
    {"name": "env_file_path", "type": "string"}
  ],
  "retryable": false,
  "tags": ["secrets", "onboarding", "setup"]
}
