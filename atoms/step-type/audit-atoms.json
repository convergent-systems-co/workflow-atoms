{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/audit-atoms",
  "version": "1.0.0",
  "name": "Audit Atoms",
  "description": "Walk the atoms directory and produce a report of all atom files, their types, IDs, and schema versions.",
  "inputs": [
    {"name": "atoms_dir", "type": "string", "required": false},
    {"name": "output_format", "type": "string", "required": false}
  ],
  "outputs": [
    {"name": "total_count", "type": "integer"},
    {"name": "by_type", "type": "object"},
    {"name": "report_path", "type": "string"}
  ],
  "retryable": true,
  "tags": ["atoms", "audit", "catalog"]
}
