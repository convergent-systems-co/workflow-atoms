{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/page-on-call",
  "version": "1.0.0",
  "name": "Page On-Call",
  "description": "Send an incident page to the on-call engineer via PagerDuty, OpsGenie, or compatible alerting system.",
  "inputs": [
    {"name": "service_key", "type": "string", "required": true},
    {"name": "summary", "type": "string", "required": true},
    {"name": "severity", "type": "string", "required": false}
  ],
  "outputs": [
    {"name": "incident_id", "type": "string"},
    {"name": "incident_url", "type": "string"}
  ],
  "retryable": true,
  "tags": ["incident", "alerting", "pagerduty"]
}
