{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/git-push",
  "version": "1.0.0",
  "name": "Git Push",
  "description": "Push a local branch to a remote repository. Prerequisite for PR creation.",
  "inputs": [
    {"name": "branch", "type": "string", "required": true},
    {"name": "remote", "type": "string", "required": false},
    {"name": "force_with_lease", "type": "boolean", "required": false}
  ],
  "outputs": [
    {"name": "sha", "type": "string"}
  ],
  "retryable": true,
  "tags": ["git", "vcs", "push"]
}
