{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/github-pr-create",
  "version": "1.0.0",
  "name": "GitHub PR Create",
  "description": "Create a GitHub pull request from a feature branch to a target branch. Requires push access to the repository.",
  "inputs": [
    {"name": "head_branch", "type": "string", "required": true},
    {"name": "base_branch", "type": "string", "required": true},
    {"name": "title", "type": "string", "required": true},
    {"name": "body", "type": "string", "required": false}
  ],
  "outputs": [
    {"name": "pr_number", "type": "integer"},
    {"name": "pr_url", "type": "string"}
  ],
  "retryable": false,
  "tags": ["github", "pr", "review"]
}
