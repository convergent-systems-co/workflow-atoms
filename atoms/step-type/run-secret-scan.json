{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/run-secret-scan",
  "version": "1.0.0",
  "name": "Run Secret Scan",
  "description": "Scan the repository for leaked secrets using trufflehog or a compatible scanner. Fails if any secrets are found.",
  "inputs": [
    {"name": "scanner", "type": "string", "required": false},
    {"name": "path", "type": "string", "required": false},
    {"name": "since_commit", "type": "string", "required": false}
  ],
  "outputs": [
    {"name": "findings_count", "type": "integer"},
    {"name": "report_path", "type": "string"}
  ],
  "retryable": false,
  "tags": ["security", "secrets", "scan"]
}
