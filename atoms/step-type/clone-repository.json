{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/clone-repository",
  "version": "1.0.0",
  "name": "Clone Repository",
  "description": "Clone one or more git repositories to a local directory.",
  "inputs": [
    {"name": "repos", "type": "array", "required": true},
    {"name": "destination", "type": "string", "required": false},
    {"name": "depth", "type": "integer", "required": false}
  ],
  "outputs": [
    {"name": "cloned_paths", "type": "array"}
  ],
  "retryable": true,
  "tags": ["git", "onboarding", "setup"]
}
