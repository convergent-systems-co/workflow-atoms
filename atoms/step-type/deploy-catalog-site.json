{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/deploy-catalog-site",
  "version": "1.0.0",
  "name": "Deploy Catalog Site",
  "description": "Deploy the atoms catalog website (Astro/static site) to the configured hosting provider after a successful catalog build.",
  "inputs": [
    {"name": "site_dir", "type": "string", "required": true},
    {"name": "provider", "type": "string", "required": false},
    {"name": "project_name", "type": "string", "required": false}
  ],
  "outputs": [
    {"name": "site_url", "type": "string"},
    {"name": "deployment_id", "type": "string"}
  ],
  "retryable": true,
  "tags": ["deploy", "catalog", "site"]
}
