{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/run-dependency-audit",
  "version": "1.0.0",
  "name": "Run Dependency Audit",
  "description": "Audit project dependencies for known vulnerabilities (npm audit, pip-audit, cargo audit, etc.).",
  "inputs": [
    {"name": "package_manager", "type": "string", "required": false},
    {"name": "severity_threshold", "type": "string", "required": false},
    {"name": "working_directory", "type": "string", "required": false}
  ],
  "outputs": [
    {"name": "vulnerability_count", "type": "integer"},
    {"name": "high_severity_count", "type": "integer"},
    {"name": "report_path", "type": "string"}
  ],
  "retryable": false,
  "tags": ["security", "dependencies", "audit"]
}
