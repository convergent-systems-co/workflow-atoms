{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/diagnose-incident",
  "version": "1.0.0",
  "name": "Diagnose Incident",
  "description": "Collect logs, metrics, and traces to produce a diagnostic snapshot for an active incident.",
  "inputs": [
    {"name": "incident_id", "type": "string", "required": true},
    {"name": "services", "type": "array", "required": false},
    {"name": "time_window_minutes", "type": "integer", "required": false}
  ],
  "outputs": [
    {"name": "diagnosis_summary", "type": "string"},
    {"name": "root_cause_hypothesis", "type": "string"},
    {"name": "report_path", "type": "string"}
  ],
  "retryable": false,
  "tags": ["incident", "diagnosis", "observability"]
}
