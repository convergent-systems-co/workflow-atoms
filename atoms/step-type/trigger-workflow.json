{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/trigger-workflow",
  "version": "1.0.0",
  "name": "Trigger Workflow",
  "description": "Dispatch a downstream workflow or pipeline (GitHub Actions workflow_dispatch, Temporal signal, etc.).",
  "inputs": [
    {"name": "workflow_id", "type": "string", "required": true},
