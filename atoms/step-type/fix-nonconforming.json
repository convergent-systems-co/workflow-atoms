{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/fix-nonconforming",
  "version": "1.0.0",
  "name": "Fix Non-Conforming Atoms",
  "description": "Apply automated or semi-automated fixes to atoms that fail schema validation. Produces a diff report of changes made.",
  "inputs": [
    {"name": "violations_report", "type": "string", "required": true},
    {"name": "dry_run", "type": "boolean", "required": false}
  ],
  "outputs": [
    {"name": "fixed_count", "type": "integer"},
    {"name": "skipped_count", "type": "integer"},
    {"name": "diff_path", "type": "string"}
  ],
  "retryable": false,
  "tags": ["atoms", "schema", "fix"]
}
