{
  "schema": "https://workflow-atoms.com/schemas/atom-v1.json",
  "type": "step-type",
  "id": "workflow-atoms/step-type/git-checkout",
  "version": "1.0.0",
  "name": "Git Checkout",
  "description": "Check out a repository at a given ref. Typically the first step in any CI pipeline.",
  "inputs": [
    {"name": "ref", "type": "string", "required": false},
    {"name": "fetch_depth", "type": "integer", "required": false}
  ],
  "outputs": [
    {"name": "sha", "type": "string"},
    {"name": "ref", "type": "string"}
  ],
  "retryable": true,
  "tags": ["git", "vcs", "checkout"]
}
